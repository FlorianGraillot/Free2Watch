# FREE2WATCH environment configuration
# Copy this file to server/.env and adjust the values.

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
JWT_SECRET=replace_with_a_long_random_secret
PORT=5000
DATABASE_PATH=./database/free2watch.db
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Optional: set to true to seed demo titles on server start (npm run seed is preferred)
SEED_DEMO_CONTENT=false
